{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GPT Image Free",
  "version": "0.1.1",
  "identifier": "cc.jonesliang.gptimagefree",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GPT Image Free",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://127.0.0.1:*; connect-src ipc: http://ipc.localhost http://127.0.0.1:* https://api.github.com https://gh-proxy.com https://github.com https://objects.githubusercontent.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
